@page
@model MallSense.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore the shops, small discoveries and promotions at Meridian Mall with MallSense." />
    <title>MallSense · Discover Meridian</title>
    <link rel="icon" href="/images/mallsense-logo.png" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" href="/" aria-label="MallSense home"><img src="@(Model.Catalog?.Logo ?? "/images/mallsense-logo.png")" alt="" width="48" height="48" />MallSense<span class="brand-dot">.</span></a>
    <nav aria-label="Main navigation"><a href="#discover">Discover</a><a href="#offers">What's on</a><a href="#directory">Directory</a></nav>
    <span class="venue">@(Model.Catalog?.MallName ?? "Meridian Mall") <span aria-hidden="true">↗</span></span>
</header>
<main>
    <section class="intro" id="discover">
        <div class="intro-copy"><p class="eyebrow">A LITTLE LOCAL KNOWLEDGE</p><h1>Your day.<br />More discoveries.</h1><p class="intro-note">A thoughtful gift, a coffee break, something for the kids.<br />Find your next stop at Meridian.</p></div>
        <div class="discovery-workspace">
            <div class="workspace-label"><span class="live-dot"></span> Where shall we start?</div>
            <form method="get" action="/#directory" class="search-form">
                <label for="query">What are you looking for?</label>
                <input id="query" name="Query" value="@Model.Query" maxlength="200" placeholder="A gift for a child who loves making things…" />
                <button type="submit">Find a place <span aria-hidden="true">↗</span></button>
            </form>
            <div class="quick-prompts" aria-label="Discovery ideas"><a href="/?Query=gift#directory">A thoughtful gift ↗</a><a href="/?Query=coffee#directory">Coffee & a pause ↗</a><a href="/?Query=kids+activity#directory">A day with the kids ↗</a></div>
            <p class="matching-note">Explore by keyword today. Conversational discovery is coming next.</p>
        </div>
        <div class="intro-footer"><span>MERIDIAN MALL / KUALA LUMPUR</span><span>Fictional demo · 13 October 2026</span></div>
    </section>
    @if (Model.Catalog is null)
    {
        <section class="empty-state"><p class="eyebrow">GETTING READY</p><h2>The directory is being prepared.</h2><p>Demo data has not been loaded yet. Setup instructions are in the project README.</p></section>
    }
    else
    {
        <section class="offers section" id="offers"><div class="section-heading"><div><p class="eyebrow">WORTH A LITTLE DETOUR</p><h2>Good things, happening here.</h2></div><span>October edits / 02</span></div>
            <div class="offer-list">
            @foreach (var offer in Model.Catalog.Promotions)
            {
                <article class="offer"><a class="poster-link" href="@offer.Poster" aria-label="View @offer.PlaceName promotion poster"><img src="@offer.Poster" alt="@offer.PlaceName: @offer.Offer. @offer.Terms" width="1024" height="1536" loading="lazy" /></a><div class="offer-copy"><p class="eyebrow">@offer.PlaceName</p><h3>@offer.Title</h3><p>@offer.Offer</p><p class="location">@offer.Location</p><details><summary>Offer details <span aria-hidden="true">+</span></summary><p>@offer.Terms</p><p>Valid until @offer.ValidUntil.ToString("d MMM yyyy").</p></details></div></article>
            }
            </div>
        </section>
        <section class="directory section" id="directory"><div class="section-heading"><div><p class="eyebrow">MAKE YOURSELF AT HOME</p><h2>@(string.IsNullOrWhiteSpace(Model.Query) ? "Explore the directory." : "Places worth exploring.")</h2></div><span>@Model.Results.Count destinations</span></div>
            <form method="get" action="/#directory" class="directory-filter"><input type="hidden" name="Query" value="@Model.Query" /><label for="category">Browse by category</label><select id="category" name="Category"><option value="">All categories</option>@foreach (var category in Model.Categories) { <option value="@category" selected="@(category == Model.Category)">@category</option> }</select><button type="submit">Apply</button><a href="/#directory">Reset</a></form>
            @if (!string.IsNullOrWhiteSpace(Model.Query)) { <p class="result-context">Keyword matches for “@Model.Query”. <a href="/#directory">Show all places</a></p> }
            @if (Model.Results.Count == 0) { <p class="no-results">No matches yet. Try “gift”, “coffee”, “books” or browse all categories.</p> }
            <div class="place-list">@foreach (var place in Model.Results) { <details class="place"><summary><span class="place-category">@place.Category</span><span class="place-name">@place.Name</span><span class="place-location">@place.Floor @(place.Unit is null ? "" : " / " + place.Unit)</span><span class="expand" aria-hidden="true">+</span></summary><div class="place-description"><p>@place.Description</p><span>View floor and unit above to find this destination.</span></div></details> }</div>
        </section>
        <section class="closing"><p class="eyebrow">FOLLOW YOUR CURIOSITY</p><h2>A little exploring<br />goes a long way.</h2><a href="#discover">Find your next stop ↗</a></section>
    }
</main>
<footer><a class="footer-brand" href="/">MallSense.</a><p>Discover what’s worth exploring.</p><span>Demo mall & offers · No live inventory</span></footer>
<script src="/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
